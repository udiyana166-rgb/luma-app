generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  // --- Monetization ---
  isPremium         Boolean   @default(false)
  premiumExpiresAt  DateTime?
  boostedUntil      DateTime? // Boost идэвхтэй бол discovery feed-д эхэнд гарна
  stripeCustomerId  String?   @unique
  stripeSubscriptionId String? @unique

  profile Profile?
  photos  Photo[]

  swipesSent     Swipe[]   @relation("SwipesSent")
  swipesReceived Swipe[]   @relation("SwipesReceived")
  matchesAsOne   Match[]   @relation("MatchUserOne")
  matchesAsTwo   Match[]   @relation("MatchUserTwo")
  messagesSent   Message[] @relation("MessagesSent")
}

model Profile {
  id               String  @id @default(uuid())
  bio              String?
  age              Int?
  city             String?
  relationshipGoal String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Photo {
  id     String  @id @default(uuid())
  url    String
  isMain Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swipe {
  id        String   @id @default(uuid())
  fromUserId String
  toUserId   String
  action     String // "LIKE" | "PASS"
  createdAt  DateTime @default(now())

  fromUser User @relation("SwipesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("SwipesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  // Нэг хэрэглэгч нөгөөг хоёр удаа swipe хийхээс сэргийлнэ
  @@unique([fromUserId, toUserId])
}

model Match {
  id                 String   @id @default(uuid())
  userOneId          String
  userTwoId          String
  compatibilityScore Int      @default(0)
  createdAt          DateTime @default(now())

  userOne  User      @relation("MatchUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("MatchUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]

  // userOneId нь үргэлж цагаан толгойн эрэмбээр жижиг байхаар normalize хийж давхардлаас сэргийлнэ
  @@unique([userOneId, userTwoId])
}

model Message {
  id        String   @id @default(uuid())
  matchId   String
  senderId  String
  text      String
  createdAt DateTime @default(now())

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}
