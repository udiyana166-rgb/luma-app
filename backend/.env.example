PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/luma"

JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Frontend-ийн бодит domain — production дээр CORS-ийг үүгээр хязгаарлана
FRONTEND_URL="http://localhost:8081"

# Cloudinary (зургийн upload) — cloudinary.com дээрээс авна
CLOUD_NAME="cloudinary_name"
CLOUD_API_KEY="cloudinary_key"
CLOUD_API_SECRET="cloudinary_secret"

# Stripe (төлбөр) — dashboard.stripe.com дээрээс авна
# Эхлээд ТЕСТ түлхүүрээр (sk_test_...) турших, бодит мөнгө хэрэглэхээс өмнө Stripe акаунтаа
# идэвхжүүлж, live түлхүүр рүү (sk_live_...) шилжинэ.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PREMIUM_PRICE_ID="price_..."   # Stripe Dashboard-д үүсгэсэн сарын багцын Price ID
STRIPE_BOOST_PRICE_ID="price_..."     # Нэг удаагийн Boost-ийн Price ID
APP_BASE_URL="http://localhost:8081"  # Stripe Checkout амжилттай/цуцлагдсаны дараа буцах frontend URL
